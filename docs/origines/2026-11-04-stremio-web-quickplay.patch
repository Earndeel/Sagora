+const deduplicate = (items) => {
+    const seen = new Set();
+    return items.filter((item) => {
+        const key = item.raw?.infoHash ? `${item.raw.infoHash.toLowerCase()}:${item.raw.fileIdx ?? ''}` : item.raw?.url;
+        if (!key || seen.has(key)) return false;
+        seen.add(key);
+        return true;
+    });
+};
+module.exports = { deduplicate };
