+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { select } = require('./select');
+
+test('rejects a private source even when it is cached', () => {
+    const results = select([{ id: 'one', provenance: 'private', cached: true }], {});
+    assert.deepEqual(results, []);
+});
+
+test('accepts only the exact video with verified required audio and compatible video', () => {
+    const policy = { videoId: 'show:1:2', audio: 'fr', maxResolution: 1080, codecs: ['h264'], hdr: ['sdr'] };
+    const good = { id: 'a', videoId: 'show:1:2', provenance: 'public_verified', audio: ['fr'], resolution: 1080, codec: 'h264', hdr: 'sdr' };
+    const results = select([
+        good,
+        { ...good, id: 'wrong', videoId: 'show:1:3' },
+        { ...good, id: 'unknown-audio', audio: null },
+        { ...good, id: '4k', resolution: 2160 },
+        { ...good, id: 'dv', hdr: 'dolby-vision' },
+        { ...good, id: 'unknown-codec', codec: null },
+        { ...good, id: 'unknown-origin', provenance: 'unknown' },
+    ], policy);
+    assert.deepEqual(results.map((x) => x.id), ['a']);
+});
+
+test('prefers a cached source closer to the device resolution without changing hard constraints', () => {
+    const policy = { videoId: 'movie', audio: 'fr', maxResolution: 1080, codecs: ['h264'], hdr: ['sdr'] };
+    const base = { videoId: 'movie', provenance: 'public_verified', audio: ['fr'], codec: 'h264', hdr: 'sdr' };
+    const sources = [
+        { ...base, id: '720', resolution: 720, cached: true },
+        { ...base, id: '1080', resolution: 1080, cached: true },
+        { ...base, id: '4k', resolution: 2160, cached: true },
+    ];
+    assert.deepEqual(select(sources, policy).map((x) => x.id), ['1080', '720']);
+});
+
+test('rejects a source without a stable release identity', () => {
+    const policy = { videoId: 'movie', audio: 'fr', maxResolution: 1080, codecs: ['h264'], hdr: ['sdr'] };
+    const source = { videoId: 'movie', provenance: 'public_verified', audio: ['fr'], resolution: 1080, codec: 'h264', hdr: 'sdr' };
+    assert.deepEqual(select([source], policy), []);
+});
