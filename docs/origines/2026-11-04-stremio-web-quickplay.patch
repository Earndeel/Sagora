diff --git a/src/family/quickplay/controller.js b/src/family/quickplay/controller.js
new file mode 100644
index 00000000..e3bd11fe
--- /dev/null
+++ b/src/family/quickplay/controller.js
@@ -0,0 +1,15 @@
+const { collect } = require('./collect');
+const { select } = require('./select');
+const { attempt } = require('./attempt');
+
+// Adapters must supply verified metadata and map a release ID to the original
+// Stremio player action. This controller does not fetch media or store URLs.
+const quickPlay = async ({ requests, policy, play, signal, timeoutMs, enabled = false }) => {
+    if (!enabled) return { status: 'disabled' };
+    const items = await collect(requests, { signal, timeoutMs });
+    if (signal?.aborted) return { status: 'cancelled' };
+    const eligible = select(items, policy);
+    if (!eligible.length) return { status: 'no-compatible-source' };
+    return attempt(eligible.map((item) => item.id), play, signal);
+};
+module.exports = { quickPlay };
