+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { quickPlay } = require('./controller');
+
+test('after an eligible source fails, tries the next eligible source', async () => {
+    const policy = { videoId: 'show:1:2', audio: 'fr', maxResolution: 1080, codecs: ['h264'], hdr: ['sdr'] };
+    const base = { videoId: 'show:1:2', provenance: 'public_verified', audio: ['fr'], codec: 'h264', hdr: 'sdr', resolution: 1080 };
+    const sources = [{ ...base, id: 'a' }, { ...base, id: 'b' }];
+    const tried = [];
+    const result = await quickPlay({ enabled: true, requests: [Promise.resolve(sources)], policy, play: async (id) => {
+        tried.push(id);
+        return id === 'a' ? 'failed' : 'started';
+    }});
+    assert.deepEqual(tried, ['a', 'b']);
+    assert.equal(result.status, 'started');
+});
+
+test('unknown and private sources never reach playback', async () => {
+    const policy = { videoId: 'movie', audio: 'fr', maxResolution: 1080, codecs: ['h264'], hdr: ['sdr'] };
+    const base = { videoId: 'movie', audio: ['fr'], codec: 'h264', hdr: 'sdr', resolution: 1080, cached: true };
+    let called = false;
+    const result = await quickPlay({ enabled: true, requests: [Promise.resolve([
+        { ...base, id: 'private', provenance: 'private' },
+        { ...base, id: 'unknown', provenance: 'unknown' },
+    ])], policy, play: async () => { called = true; return 'started'; } });
+    assert.equal(called, false);
+    assert.equal(result.status, 'no-compatible-source');
+});
+
+test('cancellation before addon results prevents playback', async () => {
+    const abort = new AbortController();
+    abort.abort();
+    let called = false;
+    const result = await quickPlay({ enabled: true, requests: [Promise.resolve([])], policy: {}, signal: abort.signal, play: async () => { called = true; } });
+    assert.equal(called, false);
+    assert.equal(result.status, 'cancelled');
+});
+
+test('feature is disabled unless explicitly enabled', async () => {
+    const policy = { videoId: 'movie', audio: 'fr', maxResolution: 1080, codecs: ['h264'], hdr: ['sdr'] };
+    const source = { id: 'a', videoId: 'movie', provenance: 'public_verified', audio: ['fr'], codec: 'h264', hdr: 'sdr', resolution: 1080 };
+    let called = false;
+    const result = await quickPlay({ requests: [Promise.resolve([source])], policy, play: async () => { called = true; return 'started'; } });
+    assert.equal(called, false);
+    assert.equal(result.status, 'disabled');
+});
