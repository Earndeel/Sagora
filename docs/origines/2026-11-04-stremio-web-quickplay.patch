diff --git a/src/family/quickplay/attempt.js b/src/family/quickplay/attempt.js
new file mode 100644
index 00000000..854ae4c5
--- /dev/null
+++ b/src/family/quickplay/attempt.js
@@ -0,0 +1,16 @@
+// The caller must resolve only confirmed errors, never ordinary buffering, as failed.
+const attempt = async (releases, play, signal) => {
+    const seen = new Set();
+    for (const release of releases) {
+        if (signal?.aborted) return { status: 'cancelled' };
+        if (seen.has(release)) continue;
+        if (seen.size >= 3) break;
+        seen.add(release);
+        const result = await play(release, signal);
+        if (signal?.aborted) return { status: 'cancelled' };
+        if (result === 'started') return { status: 'started', release };
+        if (result !== 'failed') return { status: 'stopped' };
+    }
+    return { status: 'exhausted' };
+};
+module.exports = { attempt };
