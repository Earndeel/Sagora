+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { attempt } = require('./attempt');
+
+test('tries at most three distinct releases after confirmed errors', async () => {
+    const seen = [];
+    const outcome = await attempt(['a', 'a', 'b', 'c', 'd'], async (id) => {
+        seen.push(id);
+        return 'failed';
+    });
+    assert.deepEqual(seen, ['a', 'b', 'c']);
+    assert.equal(outcome.status, 'exhausted');
+});
+
+test('stops after the next release starts', async () => {
+    const seen = [];
+    const result = await attempt(['a', 'b', 'c'], async (id) => {
+        seen.push(id);
+        return id === 'b' ? 'started' : 'failed';
+    });
+    assert.deepEqual(seen, ['a', 'b']);
+    assert.deepEqual(result, { status: 'started', release: 'b' });
+});
+
+test('does not treat an uncertain state as a confirmed failure', async () => {
+    const seen = [];
+    const result = await attempt(['a', 'b'], async (id) => {
+        seen.push(id);
+        return 'buffering';
+    });
+    assert.deepEqual(seen, ['a']);
+    assert.equal(result.status, 'stopped');
+});
+
+test('cancelling while a release is loading prevents another attempt', async () => {
+    const controller = new AbortController();
+    const seen = [];
+    const result = await attempt(['a', 'b'], async (id) => {
+        seen.push(id);
+        controller.abort();
+        return 'failed';
+    }, controller.signal);
+    assert.deepEqual(seen, ['a']);
+    assert.equal(result.status, 'cancelled');
+});
diff --git a/src/family/quickplay/collect.js b/src/family/quickplay/collect.js
new file mode 100644
index 00000000..ad4cd7a3
--- /dev/null
+++ b/src/family/quickplay/collect.js
@@ -0,0 +1,30 @@
+// Callers own addon requests and may abort them; late responses are ignored.
+const collect = (requests, { timeoutMs = 1500, signal } = {}) => new Promise((resolve) => {
+    const results = [];
+    let pending = requests.length;
+    let finished = false;
+    let timer;
+    const finish = () => {
+        if (finished) return;
+        finished = true;
+        clearTimeout(timer);
+        signal?.removeEventListener('abort', cancel);
+        resolve(results.slice());
+    };
+    const cancel = () => {
+        results.length = 0;
+        finish();
+    };
+    if (signal?.aborted) return cancel();
+    signal?.addEventListener('abort', cancel, { once: true });
+    timer = setTimeout(finish, Math.max(0, timeoutMs));
+    if (!pending) return finish();
+    for (const request of requests) {
+        Promise.resolve(request).then((items) => {
+            if (!finished && Array.isArray(items)) results.push(...items);
+        }, () => undefined).finally(() => {
+            if (--pending === 0) finish();
+        });
+    }
+});
+module.exports = { collect };
