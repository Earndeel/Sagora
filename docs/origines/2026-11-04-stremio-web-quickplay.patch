@@ -0,0 +1,26 @@
+// Adapter for meta_details.streams. Release text is a hint, never a safety proof.
+const normalizeResults = (groups, { videoId, classify = () => 'unknown' }) => groups.flatMap((group) => {
+    if (group?.content?.type !== 'Ready' || !Array.isArray(group.content.content)) return [];
+    return group.content.content.flatMap((stream) => {
+        if (typeof stream?.deepLinks?.player !== 'string') return [];
+        const text = `${stream.name || ''} ${stream.description || ''}`;
+        const resolution = text.match(/\b(2160|1080|720|480)p\b/i);
+        const episode = text.match(/\bS(\d{1,2})[ ._-]*E(\d{1,3})\b/i);
+        const vostfr = /\bVOSTFR\b/i.test(text);
+        const audioHint = vostfr || /\bVO\b/i.test(text) ? 'original' : /\b(VF|VFF|VFQ|FRENCH|TRUEFRENCH)\b/i.test(text) ? 'fr' : null;
+        return [{
+            id: stream.deepLinks.player,
+            playerLink: stream.deepLinks.player,
+            addon: { name: group.addon?.manifest?.name || '', transportUrl: group.addon?.transportUrl || '' },
+            raw: stream,
+            videoId,
+            identityConfidence: 'addon-request',
+            episodeHint: episode ? { season: Number(episode[1]), episode: Number(episode[2]) } : null,
+            provenance: classify(group.addon, stream),
+            audioHint,
+            subtitleHint: vostfr ? 'fr' : null,
+            resolutionHint: resolution ? Number(resolution[1]) : null,
+        }];
+    });
+});
+module.exports = { normalizeResults };
