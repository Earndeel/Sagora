+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { classify } = require('./trust');
+
+test('does not infer private tracker safety from a debrid label or cache flag', () => {
+    assert.equal(classify({ manifest: { name: 'TorBox' } }, { url: 'https://example.invalid/stream', cached: true }), 'unknown');
+});
+
+test('permits a specifically verified public domain direct video only from the official addon', () => {
+    const addon = { transportUrl: 'https://caching.stremio.net/publicdomainmovies.now.sh/manifest.json' };
+    const stream = { url: 'http://distribution.bbb3d.renderfarming.net/video/mp4/bbb_sunflower_1080p_30fps_normal.mp4' };
+    assert.equal(classify(addon, stream), 'safe-direct');
+});
+
+test('allows only the explicit isolated preview addon and its exact public test clip', () => {
+    process.env.FAMILY_QUICKPLAY = 'true';
+    const addon = { transportUrl: 'http://127.0.0.1:18081/quickplay-test/manifest.json' };
+    const clip = { url: 'https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/360/Big_Buck_Bunny_360_10s_1MB.mp4' };
+    assert.equal(classify(addon, clip), 'safe-direct');
+    assert.equal(classify(addon, { url: 'https://example.invalid/stream' }), 'unknown');
+    delete process.env.FAMILY_QUICKPLAY;
+});
+
+test('accepts a direct HTTPS archive.org media URL without relying on an addon name', () => {
+    const stream = { url: 'https://archive.org/download/feature-film/feature-film.mp4' };
+    assert.equal(classify({ manifest: { name: 'Any addon' } }, stream), 'safe-direct');
+    assert.equal(classify({}, { url: stream.url + '?token=unknown' }), 'unknown');
+    assert.equal(classify({}, { ...stream, infoHash: 'hash' }), 'unknown');
+});
diff --git a/src/family/quickplay/verify.js b/src/family/quickplay/verify.js
new file mode 100644
index 00000000..fbf51a8a
--- /dev/null
+++ b/src/family/quickplay/verify.js
@@ -0,0 +1,14 @@
+// The player's encoded stream is decoded locally by Stremio; never log either URL.
+const verifyPlayerLink = async (candidate, decodeStream) => {
+    const link = candidate.playerLink;
+    if (typeof link !== 'string' || typeof candidate.raw?.url !== 'string') return false;
+    const match = link.replace(/^#/, '').match(/^\/player\/([^/?#]+)(?:\/|\?|$)/);
+    if (!match) return false;
+    try {
+        const decoded = await decodeStream(decodeURIComponent(match[1]));
+        return decoded?.url === candidate.raw.url && !decoded?.infoHash && !decoded?.externalUrl;
+    } catch (_) {
+        return false;
+    }
+};
+module.exports = { verifyPlayerLink };
