@@ -0,0 +1,25 @@
+// Player links may contain sensitive data: keep them only in memory.
+const createSession = () => {
+    let routes = [];
+    let index = 0;
+    let videoId = null;
+    let sourcePath = null;
+    return {
+        start(id, candidates, origin) {
+            videoId = id;
+            sourcePath = origin || null;
+            routes = [...new Set(candidates)].slice(0, 3);
+            index = 0;
+        },
+        next(current) {
+            if (current !== routes[index] || index + 1 >= routes.length) return null;
+            return routes[++index];
+        },
+        source(current) { return current === routes[index] ? sourcePath : null; },
+        matches(id) { return videoId === id; },
+        clear() { routes = []; index = 0; videoId = null; sourcePath = null; }
+    };
+};
+const session = createSession();
+const nextOnError = (activeSession, current, error) => error?.critical === true ? activeSession.next(current) : null;
+module.exports = { createSession, session, nextOnError };
