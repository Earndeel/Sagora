diff --git a/src/family/quickplay/select.js b/src/family/quickplay/select.js
new file mode 100644
index 00000000..1d08fb85
--- /dev/null
+++ b/src/family/quickplay/select.js
@@ -0,0 +1,26 @@
+// Unknown media attributes are not the same as unknown tracker safety.
+const select = (sources, policy) => sources.filter((source) => {
+    if (typeof source.id !== 'string' || !source.id || source.videoId !== policy.videoId) return false;
+    if (!['public_verified', 'safe-direct'].includes(source.provenance)) return false;
+    if (source.provenance === 'public_verified') {
+        return Array.isArray(source.audio) && source.audio.includes(policy.audio) &&
+            Number.isFinite(source.resolution) && source.resolution > 0 &&
+            Number.isFinite(policy.maxResolution) && source.resolution <= policy.maxResolution &&
+            Array.isArray(policy.codecs) && policy.codecs.includes(source.codec) &&
+            Array.isArray(policy.hdr) && policy.hdr.includes(source.hdr);
+    }
+    if (source.episodeHint && policy.episode &&
+        (source.episodeHint.season !== policy.episode.season || source.episodeHint.episode !== policy.episode.episode)) return false;
+    if (source.resolutionHint && source.resolutionHint > policy.maxResolution) return false;
+    if (policy.languageStrict && (!Array.isArray(source.audio) || !source.audio.includes(policy.audio))) return false;
+    if (policy.languageStrict && policy.subtitle && (!Array.isArray(source.subtitles) || !source.subtitles.includes(policy.subtitle))) return false;
+    if (source.codec && Array.isArray(policy.codecs) && !policy.codecs.includes(source.codec)) return false;
+    if (source.hdr && Array.isArray(policy.hdr) && !policy.hdr.includes(source.hdr)) return false;
+    return true;
+}).sort((a, b) => {
+    const language = Number(b.audioHint === policy.audio) - Number(a.audioHint === policy.audio);
+    const subtitles = policy.subtitle ? Number(b.subtitleHint === policy.subtitle) - Number(a.subtitleHint === policy.subtitle) : 0;
+    return language || subtitles || (Number(b.cached === true) - Number(a.cached === true)) ||
+        ((b.resolutionHint || b.resolution || 0) - (a.resolutionHint || a.resolution || 0)) || String(a.id).localeCompare(String(b.id));
+});
+module.exports = { select };
