@@ -0,0 +1,17 @@
+const KEY = 'stremio-family-quickplay-v1';
+const sanitize = (v = {}) => ({
+    enabled: v.enabled !== false,
+    audio: ['vf', 'vostfr', 'vo'].includes(v.audio) ? v.audio : 'vf',
+    strict: v.strict === true,
+    collectionMs: [0, 600, 1500].includes(v.collectionMs) ? v.collectionMs : 600,
+    maxResolution: [480, 720, 1080, 2160].includes(v.maxResolution) ? v.maxResolution : 1080,
+});
+const load = () => {
+    try { return sanitize(JSON.parse(localStorage.getItem(KEY) || '{}')); } catch (_) { return sanitize(); }
+};
+const save = (value) => {
+    const prefs = sanitize(value);
+    try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch (_) { /* private mode */ }
+    return prefs;
+};
+module.exports = { sanitize, load, save };
