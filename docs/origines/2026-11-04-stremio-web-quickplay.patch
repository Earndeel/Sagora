+// Experimental integration: enabled only in an explicitly configured preview build.
+const React = require('react');
+const PropTypes = require('prop-types');
+const { useTranslation } = require('react-i18next');
+const { useLocation, useNavigate } = require('react-router');
+const { useCore } = require('stremio/core');
+const { default: toPath } = require('stremio-router/toPath');
+const { normalizeResults } = require('stremio/family/quickplay/adapter');
+const { select } = require('stremio/family/quickplay/select');
+const { classify } = require('stremio/family/quickplay/trust');
+const { session } = require('stremio/family/quickplay/session');
+const { load, save } = require('stremio/family/quickplay/settings');
+const { verifyPlayerLink } = require('stremio/family/quickplay/verify');
+const { deduplicate } = require('stremio/family/quickplay/deduplicate');
+const styles = require('./styles');
+
+const QuickPlay = ({ streams, requestId, video, playerType }) => {
+    const { t } = useTranslation();
+    const navigate = useNavigate();
+    const core = useCore();
+    const location = useLocation();
+    const [settings, setSettings] = React.useState(load);
+    const latest = React.useRef(null);
+    const timer = React.useRef(null);
+    const launched = React.useRef(false);
+    const pending = React.useRef(false);
+    const mounted = React.useRef(true);
+    const loading = streams.some((group) => group.content?.type === 'Loading');
+    const candidates = React.useMemo(() => {
+        if (!requestId) return [];
+        const policy = {
+            videoId: requestId,
+            audio: settings.audio === 'vf' ? 'fr' : 'original',
+            subtitle: settings.audio === 'vostfr' ? 'fr' : null,
+            languageStrict: settings.strict,
+            maxResolution: settings.maxResolution,
+            episode: Number.isInteger(video?.season) && Number.isInteger(video?.episode) ? { season: video.season, episode: video.episode } : null,
+        };
+        return select(normalizeResults(streams, { videoId: requestId, classify }), policy);
+    }, [streams, requestId, settings, video]);
+    latest.current = { candidates, requestId, enabled: settings.enabled, settingsKey: JSON.stringify(settings), playerType, sourcePath: location.pathname + location.search };
+    const launch = React.useCallback(async () => {
+        timer.current = null;
+        const current = latest.current;
+        if (!current.enabled || current.playerType !== null || !current.requestId || !current.candidates.length || session.matches(current.requestId) || launched.current || pending.current) return;
+        pending.current = true;
+        const checks = await Promise.all(current.candidates.map((candidate) => verifyPlayerLink(candidate, core.transport.decodeStream)));
+        pending.current = false;
+        if (!mounted.current || !latest.current.enabled || latest.current.requestId !== current.requestId || latest.current.settingsKey !== current.settingsKey || latest.current.sourcePath !== current.sourcePath) return;
+        const routes = deduplicate(current.candidates.filter((candidate, index) => checks[index])).map((candidate) => toPath(candidate.playerLink));
+        if (!routes.length) return;
+        session.start(current.requestId, routes, current.sourcePath);
+        launched.current = true;
+        navigate(routes[0]);
+    }, [navigate, core.transport]);
+    React.useEffect(() => {
+        if (timer.current !== null) clearTimeout(timer.current);
+        timer.current = null;
+    }, [settings.collectionMs]);
+    React.useEffect(() => {
+        if (!settings.enabled || playerType !== null || !requestId || session.matches(requestId) || launched.current || !candidates.length) {
+            if (timer.current !== null) clearTimeout(timer.current);
+            timer.current = null;
+            return;
+        }
+        if (!loading) {
+            if (timer.current !== null) clearTimeout(timer.current);
+            timer.current = null;
+            launch();
+        } else if (timer.current === null) {
+            timer.current = setTimeout(launch, settings.collectionMs);
+        }
+    }, [settings.enabled, settings.collectionMs, playerType, requestId, candidates, loading, launch]);
+    React.useEffect(() => {
+        mounted.current = true;
+        return () => {
+            mounted.current = false;
+            if (timer.current !== null) clearTimeout(timer.current);
+        };
+    }, []);
+    const update = (patch) => setSettings((old) => save({ ...old, ...patch }));
+    return <div className={styles['quickplay']}>
+        <label><input type='checkbox' checked={settings.enabled} onChange={(event) => update({ enabled: event.target.checked })} />{t('FAMILY_QUICKPLAY_ENABLE', { defaultValue: 'Lecture automatique (préproduction)' })}</label>
+        <label>{t('FAMILY_QUICKPLAY_LANGUAGE', { defaultValue: 'Langue' })} <select value={settings.audio} onChange={(event) => update({ audio: event.target.value })}>
+            <option value='vf'>{t('FAMILY_QUICKPLAY_VF', { defaultValue: 'VF' })}</option><option value='vostfr'>{t('FAMILY_QUICKPLAY_VOSTFR', { defaultValue: 'VOSTFR' })}</option><option value='vo'>{t('FAMILY_QUICKPLAY_VO', { defaultValue: 'VO' })}</option>
+        </select></label>
+        <label><input type='checkbox' checked={settings.strict} onChange={(event) => update({ strict: event.target.checked })} />{t('FAMILY_QUICKPLAY_LANGUAGE_REQUIRED', { defaultValue: 'Langue obligatoire' })}</label>
+        <label>{t('FAMILY_QUICKPLAY_MAX_QUALITY', { defaultValue: 'Qualité maximale' })} <select value={settings.maxResolution} onChange={(event) => update({ maxResolution: Number(event.target.value) })}>
+            <option value='480'>{t('FAMILY_QUICKPLAY_480', { defaultValue: '480p' })}</option><option value='720'>{t('FAMILY_QUICKPLAY_720', { defaultValue: '720p' })}</option><option value='1080'>{t('FAMILY_QUICKPLAY_1080', { defaultValue: '1080p' })}</option><option value='2160'>{t('FAMILY_QUICKPLAY_2160', { defaultValue: '2160p' })}</option>
+        </select></label>
+        <label>{t('FAMILY_QUICKPLAY_WINDOW', { defaultValue: 'Attente des sources' })} <select value={settings.collectionMs} onChange={(event) => update({ collectionMs: Number(event.target.value) })}>
+            <option value='0'>{t('FAMILY_QUICKPLAY_IMMEDIATE', { defaultValue: 'Immédiate' })}</option><option value='600'>{t('FAMILY_QUICKPLAY_600MS', { defaultValue: '0,6 seconde' })}</option><option value='1500'>{t('FAMILY_QUICKPLAY_1500MS', { defaultValue: '1,5 seconde' })}</option>
+        </select></label>
+        {settings.enabled && !loading && !candidates.length ? <span>{t('FAMILY_QUICKPLAY_MANUAL', { defaultValue: 'Aucune source automatiquement admissible : choisissez une source ci-dessous.' })}</span> : null}
+        {settings.enabled && playerType !== null ? <span>{t('FAMILY_QUICKPLAY_INTERNAL_PLAYER', { defaultValue: 'La sélection automatique nécessite le lecteur intégré.' })}</span> : null}
+    </div>;
+};
+QuickPlay.propTypes = {
+    streams: PropTypes.arrayOf(PropTypes.object).isRequired,
+    requestId: PropTypes.string,
+    video: PropTypes.shape({ season: PropTypes.number, episode: PropTypes.number }),
+    playerType: PropTypes.string,
+};
+module.exports = QuickPlay;
