@@ -0,0 +1,21 @@
+// Stremio's public-domain repository explicitly lists this public direct video.
+// No decision is inferred from a provider name, a cache icon, or a URL suffix.
+const classify = (addon, stream) => {
+    if (addon?.transportUrl === 'https://caching.stremio.net/publicdomainmovies.now.sh/manifest.json' &&
+        stream?.url === 'http://distribution.bbb3d.renderfarming.net/video/mp4/bbb_sunflower_1080p_30fps_normal.mp4' &&
+        !stream?.infoHash && !stream?.externalUrl) return 'safe-direct';
+    if (process.env.FAMILY_QUICKPLAY === 'true' &&
+        addon?.transportUrl === 'http://127.0.0.1:18081/quickplay-test/manifest.json' &&
+        stream?.url === 'https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/360/Big_Buck_Bunny_360_10s_1MB.mp4' &&
+        !stream?.infoHash && !stream?.externalUrl) return 'safe-direct';
+    if (!stream?.infoHash && !stream?.externalUrl && typeof stream?.url === 'string') {
+        try {
+            const url = new URL(stream.url);
+            if (url.protocol === 'https:' && url.hostname === 'archive.org' && !url.port &&
+                !url.username && !url.password && !url.search && !url.hash &&
+                /^\/download\/[^/]+\/[^/]+\.mp4$/i.test(url.pathname)) return 'safe-direct';
+        } catch (_) { return 'unknown'; }
+    }
+    return 'unknown';
+};
+module.exports = { classify };
