@@ -0,0 +1,29 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { createSession } = require('./session');
+
+test('retries only twice and only for the active player route', () => {
+    const session = createSession();
+    session.start('episode', ['/player/a', '/player/b', '/player/c', '/player/d']);
+    assert.equal(session.next('/player/not-current'), null);
+    assert.equal(session.next('/player/a'), '/player/b');
+    assert.equal(session.next('/player/b'), '/player/c');
+    assert.equal(session.next('/player/c'), null);
+});
+
+test('only a critical player error advances to an alternative', () => {
+    const { nextOnError } = require('./session');
+    const session = createSession();
+    session.start('movie', ['/player/a', '/player/b']);
+    assert.equal(nextOnError(session, '/player/a', { critical: false }), null);
+    assert.equal(nextOnError(session, '/player/a', { critical: true }), '/player/b');
+});
+
+test('retains the manual source list route only for the active session', () => {
+    const session = createSession();
+    session.start('movie', ['/player/a'], '/detail/movie');
+    assert.equal(session.source('/player/a'), '/detail/movie');
+    assert.equal(session.source('/player/other'), null);
+    session.clear();
+    assert.equal(session.source('/player/a'), null);
+});
