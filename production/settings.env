# Réglages non secrets de la production AIOStreams (application familiale).
BASE_URL=https://stremio.walter-ai.cloud
DATABASE_URI=sqlite://./data/db.sqlite
LOG_LEVEL=info
LOG_FORMAT=json
SETTINGS_REFRESH_INTERVAL=0
# Variantes : 3 de la famille + une par langue d interface (fiches TMDB dans la langue du profil)
MAX_VARIANTS=30
# Nom du projet (nom du serveur quand une configuration n'en donne pas, page de configuration)
ADDON_NAME=Sagora
# Moteur Usenet : profil « high » (lecture plus soutenue ; mesuré le 2026-11-05)
USENET_PERFORMANCE_PROFILE=high
# Liste des index de Prowlarr relue toutes les 5 min (14 jours par défaut) : un tracker ajouté sert vite
BUILTIN_PROWLARR_INDEXERS_CACHE_TTL=300
# Relais TorBox hébergé dans la pile (2026-11-05) au lieu de stremthru.13377001.xyz
BUILTIN_STREMTHRU_URL=http://stremthru:8080
